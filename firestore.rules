rules_version = '2';
// Hráč smí zapisovat jen svůj požadavek na převzetí a svůj profil. Soupisku spravuje jen ingest (service account).
service cloud.firestore {
  match /databases/{db}/documents {
    match /claims/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // status smí hráč nastavit jen na pending (done zapisuje jen smyčka); potvrzené převzetí už nepřepíše
      allow create, update: if request.auth != null && request.auth.uid == uid
        && (resource == null || resource.data.status != 'done')
        && request.resource.data.keys().hasOnly(['handle', 'code', 'uid', 'status', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.code is string && request.resource.data.code.matches('^ENLIST-[A-Z0-9]{4}$')
        && request.resource.data.handle is string && request.resource.data.handle.matches('^[a-z0-9._]{1,30}$');
    }
    match /profiles/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['bio', 'pronoun', 'role', 'volunteer', 'updatedAt'])
        && (!('volunteer' in request.resource.data) || (request.resource.data.volunteer is string && request.resource.data.volunteer.size() <= 40))
        && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 280))
        && (!('pronoun' in request.resource.data) || (request.resource.data.pronoun is string && request.resource.data.pronoun.size() <= 10))
        && (!('role' in request.resource.data) || (request.resource.data.role is string && request.resource.data.role.size() <= 20));
    }
  }
}
